-  "%{!nostdlib:-lunixlib }"
+  "%{!nostdlib:%{pthread:-lpthread} %{rdynamic:%{!shared:-lstdc++ -lm %{!no-whole-unixlib:--whole-archive -lunixlib --no-whole-archive}}} -lunixlib }"
   
