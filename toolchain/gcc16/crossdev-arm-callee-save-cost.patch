+/* Implement TARGET_CALLEE_SAVE_COST.  The core registers r4-r11 are saved
+   and restored by the one PUSH/POP (STMDB/LDMIA) that a function's
+   prologue and epilogue use anyway: as soon as anything is saved (the
+   link register, in any non-leaf function), each further core register is
+   one more register in that instruction, not a separate store or load.
+   Cost it so (1, which is still more than not saving it), as aarch64 does
+   for turning an STR into an STP.  Without this, the default (a separate
+   store or load) makes the allocator prefer spilling values that live
+   across calls to the stack over using r8-r11 in Thumb-2.  */
+static int
+arm_callee_save_cost (spill_cost_type spill_type, unsigned int regno,
+		      machine_mode mode, unsigned int nregs, int mem_cost,
+		      const HARD_REG_SET &callee_saved_regs,
+		      bool existing_spills_p)
+{
+  if (TARGET_32BIT
+      && regno <= LAST_ARM_REGNUM
+      && !optimize_function_for_size_p (cfun))
+    return nregs;
+  return default_callee_save_cost (spill_type, regno, mode, nregs, mem_cost,
+				   callee_saved_regs, existing_spills_p);
+}
+
 struct gcc_target targetm = TARGET_INITIALIZER;
 
